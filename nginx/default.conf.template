limit_req_zone $binary_remote_addr zone=places_per_ip:10m rate=6r/m;
limit_req_zone $server_name zone=places_total:1m rate=60r/m;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    location / { try_files $uri $uri/ /index.html; }

    location = /api/places/nearby {
        set $places_method searchNearby;
        include /etc/nginx/places-proxy.conf;
    }
    location = /api/places/search {
        set $places_method searchText;
        include /etc/nginx/places-proxy.conf;
    }
    location /api/ { return 404; }
}
