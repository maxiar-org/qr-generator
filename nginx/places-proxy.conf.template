if ($request_method != POST) { return 405; }
set $places_key "${GOOGLE_PLACES_API_KEY}";
if ($places_key = "") { return 503; }
client_max_body_size 4k;
limit_req zone=places_per_ip burst=3 nodelay;
limit_req zone=places_total burst=10 nodelay;
limit_req_status 429;
resolver 1.1.1.1 8.8.8.8 valid=300s;
proxy_ssl_server_name on;
proxy_ssl_name places.googleapis.com;
proxy_ssl_verify on;
proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
proxy_pass_request_headers off;
proxy_set_header Host places.googleapis.com;
proxy_set_header Content-Type application/json;
proxy_set_header X-Goog-Api-Key $places_key;
proxy_set_header X-Goog-FieldMask places.id,places.displayName,places.formattedAddress;
proxy_connect_timeout 5s;
proxy_read_timeout 20s;
proxy_hide_header Access-Control-Allow-Origin;
add_header Cache-Control "no-store" always;
proxy_pass https://places.googleapis.com/v1/places:$places_method;
